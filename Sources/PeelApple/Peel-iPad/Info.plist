<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PeelICloudPairingAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.zephyrstudiosllc.Peel.icloud-pairing</string>
	<key>PeelNativeAppleSignInEnabled</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Peel Pro</string>
	<key>PeelAISubscriptionProductIDs</key>
	<array>
		<string>peel.pro.monthly</string>
		<string>peel.pro.yearly</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_peel._tcp</string>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
</dict>
</plist>
