<UserControl x:Class="Peel.Windows.Client.Utilities.LightingStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Peel.Windows.Client.Utilities">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Save changes" Style="{StaticResource StudioPrimary}" Command="{Binding SaveLightingProfileCommand}" AutomationProperties.Name="Save profile and state" Margin="16,0,0,0"/>
   <StackPanel Orientation="Horizontal"><TextBlock Text="Profile" VerticalAlignment="Center" Foreground="{StaticResource StudioMuted}" Margin="0,0,12,0"/><ComboBox Width="210" ItemsSource="{Binding LightingProfiles}" SelectedValue="{Binding SelectedLightingProfile}" SelectedValuePath="Id" DisplayMemberPath="Label" AutomationProperties.Name="Lighting profile"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Agent states" Style="{StaticResource StudioCaption}" Margin="10,8,0,10"/>
    <ListBox ItemsSource="{Binding ProfileStateChoices}" SelectedValue="{Binding ProfileState}" SelectedValuePath="Id" ItemContainerStyle="{StaticResource StudioSelection}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Profile state">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Fill="{Binding Color}" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource StudioMuted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Separator Margin="8,16"/><TextBlock Text="Presentation" Style="{StaticResource StudioCaption}" Margin="10,0,0,8"/>
    <ComboBox ItemsSource="{Binding AgentDisplayModes}" SelectedValue="{Binding AgentDisplayMode}" SelectedValuePath="Id" DisplayMemberPath="Label" AutomationProperties.Name="Agent display mode" FontSize="11"/>
    <TextBlock Text="Per agent gives each visible session its own lights." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource StudioMuted}" Margin="10,12,10,8"/>
   </StackPanel></Border></ScrollViewer>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
    <Border Style="{StaticResource Card}" CornerRadius="24" Padding="24"><StackPanel>
     <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ProfileStateTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding ProfileStateDescription}" Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" Margin="0,8,18,0"/></StackPanel><Border Grid.Column="1" Width="72" Height="72" CornerRadius="18" Background="{Binding ProfileColor}" BorderBrush="#55FFFFFF" BorderThickness="1"/></Grid>
     <TextBlock Text="Color behavior" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <ComboBox ItemsSource="{Binding ProfileColorChoices}" SelectedValue="{Binding ProfileColorMode}" SelectedValuePath="Id" DisplayMemberPath="Label" AutomationProperties.Name="Profile color mode"/>
     <Grid Margin="0,18,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Primary color" Style="{StaticResource StudioCaption}"/><TextBox Text="{Binding ProfileColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Primary light color"/><Button Content="Choose color…" Tag="primary" Click="ChooseColor_Click" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Secondary color" Style="{StaticResource StudioCaption}"/><TextBox Text="{Binding ProfileSecondaryColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Secondary light color"/><Button Content="Choose color…" Tag="secondary" Click="ChooseColor_Click" Margin="0,8,0,0"/></StackPanel>
     </Grid>
     <TextBlock Text="Motion" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <ComboBox ItemsSource="{Binding ProfileMotionChoices}" SelectedValue="{Binding ProfileMotion}" SelectedValuePath="Id" DisplayMemberPath="Label" AutomationProperties.Name="Profile motion"/>
     <Grid Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cycle · seconds" Style="{StaticResource StudioCaption}"/><TextBox Text="{Binding ProfileCycle, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.##}" AutomationProperties.Name="Light cycle seconds"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Intensity" Style="{StaticResource StudioCaption}"/><Slider Value="{Binding ProfileIntensity}" Minimum="0" Maximum="1" Margin="0,10,0,0" AutomationProperties.Name="State light intensity"/></StackPanel></Grid>
     <TextBlock Text="Thinking and Tool Running share motion, speed and intensity. Their colors stay independent." TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" FontSize="12" Margin="0,0,0,16"/>
     <Button Content="Restore state style" Command="{Binding ResetProfileStateCommand}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Light allocation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <ComboBox ItemsSource="{Binding AllocationStrategies}" SelectedValue="{Binding ProfileStrategy}" SelectedValuePath="Id" DisplayMemberPath="Label" AutomationProperties.Name="Light allocation strategy"/>
     <TextBlock Text="Profile brightness" Style="{StaticResource StudioCaption}" Margin="0,18,0,8"/><Slider Value="{Binding ProfileBrightness}" Minimum="0" Maximum="1" AutomationProperties.Name="Profile brightness"/>
     <TextBlock Text="{Binding ActivityLabel}" TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="0,18,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PRO · 8 LIGHTS" Style="{StaticResource StudioCaption}"/><Border Background="#191D24" CornerRadius="16" Padding="8"><local:SignalLights Program="{Binding ActivityProgram}" StartedAt="{Binding ActivityStartedAt}" ValidUntil="{Binding ActivityValidUntil}" Height="36" AutomationProperties.Name="Pro profile output preview"/></Border></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DOT · 2 LIGHTS" Style="{StaticResource StudioCaption}"/><Border Background="#191D24" CornerRadius="16" Padding="8"><local:SignalLights LedCount="2" Program="{Binding ActivityDotProgram}" StartedAt="{Binding ActivityStartedAt}" ValidUntil="{Binding ActivityValidUntil}" Height="36" AutomationProperties.Name="Dot profile output preview"/></Border></StackPanel></Grid>
     <TextBlock Text="{Binding AllocationStatus}" TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" FontSize="12" Margin="0,16,0,12"/>
     <DataGrid ItemsSource="{Binding LightAllocations}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300" AutomationProperties.Name="Local agent light assignments"><DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding Output}" Width="65"/><DataGridTextColumn Header="Lights" Binding="{Binding Lights}" Width="145"/><DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="*" MinWidth="100"/><DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="100"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Profile library" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock Text="Profile name" Style="{StaticResource StudioCaption}"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Profile name" Margin="0,0,0,14"/>
     <WrapPanel><Button Content="New" Command="{Binding NewLightingProfileCommand}"/><Button Content="Duplicate" Command="{Binding DuplicateLightingProfileCommand}"/><Button Content="Delete" Command="{Binding DeleteLightingProfileCommand}" IsEnabled="{Binding CanDeleteProfile}"/></WrapPanel>
     <WrapPanel Margin="0,8,0,8"><Button Content="Add Quiet Night" Command="{Binding AddQuietProfileCommand}"/><Button Content="Add High Signal" Command="{Binding AddHighProfileCommand}"/></WrapPanel>
     <TextBlock Text="{Binding DefaultProfileLabel}" Foreground="{StaticResource StudioMuted}" Margin="0,8,0,12"/><WrapPanel><Button Content="Make default" Command="{Binding DefaultLightingProfileCommand}"/><Button Content="Use default" Command="{Binding UseDefaultLightingProfileCommand}"/></WrapPanel>
     <WrapPanel Margin="0,12,0,0"><Button Content="Import…" Command="{Binding ImportLightingProfilesCommand}"/><Button Content="Export library…" Command="{Binding ExportLightingProfilesCommand}"/></WrapPanel>
     <TextBlock Text="Profiles use the SidePulse JSON format. Imports add profiles to your library." Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Changes apply when saved. Paired sources retain their own styles." Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Expander Header="Advanced state programs"><StackPanel Margin="0,12,0,12"><TextBlock Text="{Binding ProfileOverrideNote}" TextWrapping="Wrap"/><Button Content="Use profile programs" Command="{Binding UseProfileProgramsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
