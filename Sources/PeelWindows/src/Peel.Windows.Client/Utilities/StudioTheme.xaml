<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="StudioInk" Color="#EDF0F4"/>
 <SolidColorBrush x:Key="StudioMuted" Color="#A4ADB9"/>
 <SolidColorBrush x:Key="StudioPanel" Color="#292D35"/>
 <SolidColorBrush x:Key="StudioLine" Color="#414650"/>
 <SolidColorBrush x:Key="StudioAccent" Color="#78BCFF"/>
 <LinearGradientBrush x:Key="StudioBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#24272D" Offset="0"/><GradientStop Color="#222B33" Offset=".5"/><GradientStop Color="#2B2835" Offset="1"/></LinearGradientBrush>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/></Style>
 <Style TargetType="ItemsControl"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/></Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="Background" Value="#3B404A"/><Setter Property="BorderBrush" Value="#515762"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#505968"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource StudioAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StudioPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1468BD"/><Setter Property="BorderBrush" Value="#3991E6"/></Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="Background" Value="#20242B"/><Setter Property="BorderBrush" Value="{StaticResource StudioLine}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#3F75A7"/><Setter Property="Padding" Value="10,8"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="Background" Value="#303640"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#3E6185"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="Background" Value="#363C46"/><Setter Property="BorderBrush" Value="#515762"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="#515762" BorderThickness="1" CornerRadius="8"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="10,8,32,8" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#303640" BorderBrush="#626C7A" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340" Padding="4"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StudioScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="StudioScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#6B7482" CornerRadius="4" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource StudioScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource StudioScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource StudioScrollPage}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource StudioScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource StudioScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource StudioScrollPage}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource StudioInk}"/></Style>
 <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource StudioAccent}"/></Style>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="#242931"/><Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="RowBackground" Value="#292F38"/><Setter Property="AlternatingRowBackground" Value="#262B33"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="MinRowHeight" Value="38"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#343B46"/><Setter Property="Foreground" Value="{StaticResource StudioMuted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource StudioPanel}"/><Setter Property="BorderBrush" Value="{StaticResource StudioLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 <Style x:Key="StudioCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource StudioMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="StudioSelection" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{StaticResource StudioInk}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#353C47"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#354F6C"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#78BCFF"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
