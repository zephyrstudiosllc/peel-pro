                                                      IsEnabled="False"
                                                      Click="HostRemoteInput_Click"
                                                      AutomationProperties.AutomationId="HostRemoteInputGate"
                                                      AutomationProperties.Name="Allow the connected device to control this PC" />
                                        </Grid>

                                        <Border Height="1" Background="#FF3F4447" Margin="0,0,0,12" />

                                        <Button Click="HostWindowsOptionsDisclosure_Click"
                                                Style="{StaticResource HostSubDisclosureButton}"
                                                AutomationProperties.AutomationId="HostWindowsOptionsDisclosure"
                                                AutomationProperties.Name="Windows options">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE897;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HostMutedBrush}"
                                                           Margin="0,1,8,0" />
                                                <StackPanel>
                                                    <TextBlock Text="Windows Options" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="Sign-in behavior and available-window details."
                                                               Margin="0,2,0,0"
                                                               Foreground="{StaticResource HostMutedBrush}"
                                                               FontSize="10" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel x:Name="HostWindowsOptionsContent" Visibility="Collapsed" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Start at sign-in" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="HostLaunchAtLoginStatusText"
                                                               Text="Off. Peel Pro starts in the tray with remote input off."
                                                               Margin="0,3,10,0"
                                                               Foreground="{StaticResource HostMutedBrush}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox x:Name="HostLaunchAtLoginCheckBox"
                                                          Grid.Column="1"
                                                          Style="{StaticResource HostSwitch}"
                                                          Margin="8,0,0,0"
                                                          IsChecked="False"
                                                          Click="HostLaunchAtLogin_Click"
                                                          AutomationProperties.AutomationId="HostLaunchAtLogin"
                                                          AutomationProperties.Name="Start Peel Pro when I sign in" />
                                            </Grid>
                                            <Grid Margin="0,14,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Available windows" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="HostWindowCountText"
                                                               Text="Checking this PC…"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource HostMutedBrush}"
                                                               FontSize="10" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Refresh"
                                                        Click="RefreshHostWindows_Click"
                                                        Style="{StaticResource HostSmallButton}"
                                                        Padding="10,5"
                                                        FontSize="10"
                                                        AutomationProperties.AutomationId="HostRefreshWindows"
                                                        AutomationProperties.Name="Refresh available windows" />
                                            </Grid>
                                            <ListBox x:Name="HostWindowsList"
                                                     MaxHeight="150"
                                                     Foreground="{StaticResource HostTextBrush}"
                                                     ItemContainerStyle="{StaticResource HostListBoxItem}"
                                                     AutomationProperties.AutomationId="HostAvailableWindows"
                                                     AutomationProperties.Name="Available windows">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ProcessName}" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource HostMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="HostVideoStatusText"
                                                       Text="H.264 window and display streaming ready on demand"
                                                       Margin="0,12,0,0"
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="HostVideoStatus" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource HostCardBrush}" CornerRadius="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Button Click="HostPairDisclosure_Click"
                                            Style="{StaticResource HostDisclosureButton}"
                                            MinHeight="64"
                                            AutomationProperties.AutomationId="HostPairDisclosure"
                                            AutomationProperties.Name="Pair">
                                        <StackPanel>
                                            <TextBlock Text="Pair" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Expand for 6-digit code."
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="HostPairContent" Visibility="Collapsed" Margin="12,0,12,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="6-digit Pairing Code" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="RefreshHostPairingButton"
                                                        Click="RefreshHostPairing_Click"
                                                        Style="{StaticResource HostSmallButton}"
                                                        Width="30"
                                                        Height="28"
                                                        Padding="0"
                                                        IsEnabled="False"
                                                        AutomationProperties.AutomationId="HostRefreshPairingPin"
                                                        AutomationProperties.Name="Generate new pairing PIN">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                </Button>
                                                <Button
                                                        Click="CopyHostPairingPin_Click"
                                                        Style="{StaticResource HostSmallButton}"
                                                        Margin="6,0,0,0"
                                                        Width="30"
                                                        Height="28"
                                                        Padding="0"
                                                        AutomationProperties.AutomationId="HostCopyPairingPin"
                                                        AutomationProperties.Name="Copy pairing PIN">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border Margin="0,10,0,0" Padding="8,6" Background="#FF303538" CornerRadius="12">
                                            <TextBlock x:Name="HostPairingPinText"
                                                       Text="——————"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="48"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       AutomationProperties.AutomationId="HostPairingPin" />
                                        </Border>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="On your other device, open Peel Pro, tap Pair, and enter this code."
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="HostPairingExpiryText"
                                                       Grid.Column="1"
                                                       Text="Waiting…"
                                                       Margin="8,0,0,0"
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="10" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource HostCardBrush}" CornerRadius="14">
                                <StackPanel>
                                    <Button Click="HostDevicesDisclosure_Click"
                                            Style="{StaticResource HostDisclosureButton}"
                                            AutomationProperties.AutomationId="HostDevicesDisclosure"
                                            AutomationProperties.Name="Devices">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" />
                                                <Border Margin="8,0,0,0"
                                                        Background="#FF3A3F42"
                                                        CornerRadius="10"
                                                        Padding="7,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="HostPairedDevicesCountText"
                                                               Text="0"
                                                               Foreground="{StaticResource HostMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HostPairedDevicesSubtitleText"
                                                       Text="No paired devices yet."
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="HostDevicesContent" Visibility="Collapsed" Margin="12,0,12,12">
                                        <TextBlock x:Name="HostPairedClientsText"
                                                   Text="No paired devices yet."
                                                   Foreground="{StaticResource HostMutedBrush}"
                                                   FontSize="11" />
                                        <ListBox x:Name="HostPairedClientsList"
                                                 MaxHeight="150"
                                                 Margin="0,8,0,8"
                                                 Foreground="{StaticResource HostTextBrush}"
                                                 ItemContainerStyle="{StaticResource HostListBoxItem}"
                                                 SelectionChanged="HostPairedClients_SelectionChanged"
                                                 AutomationProperties.AutomationId="HostPairedDevices"
                                                 AutomationProperties.Name="Paired devices">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10" Background="#FF303538" CornerRadius="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ActivityLabel}" Margin="0,4,0,0" Foreground="{StaticResource HostMutedBrush}" FontSize="10" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Tag="{Binding PairingId}"
                                                                    Click="ForgetHostPairedClientRow_Click"
                                                                    Style="{StaticResource HostSmallButton}"
                                                                    Width="30"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Margin="10,0,0,0"
                                                                    AutomationProperties.AutomationId="HostForgetPairedDevice"
                                                                    AutomationProperties.Name="Unpair this device">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button x:Name="ForgetHostPairedClientButton"
                                                Content="Forget selected device"
                                                Click="ForgetHostPairedClient_Click"
                                                Style="{StaticResource HostSmallButton}"
                                                HorizontalAlignment="Left"
                                                IsEnabled="False"
                                                Visibility="Collapsed"
                                                AutomationProperties.AutomationId="HostForgetPairedDevice" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="56,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF373B3E" />
                        <StackPanel Grid.Row="1"
                                    Margin="0,48,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                            <Button Content="Close"
                                    Click="CloseHostWindow_Click"
                                    Style="{StaticResource HostSmallButton}"
                                    Background="#FF0A84FF"
                                    Foreground="White"
                                    Width="240"
                                    Height="29"
                                    AutomationProperties.AutomationId="HostCloseButton" />
                            <Button Content="Restart"
                                    Click="RestartHost_Click"
                                    Style="{StaticResource HostSmallButton}"
                                    Width="128"
                                    Height="29"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="HostRestartButton" />
                            <Button Content="Quit"
                                    Click="QuitPeel_Click"
                                    Style="{StaticResource HostSmallButton}"
                                    Width="128"
                                    Height="29"
                                    Margin="0,7,0,0"
                                    AutomationProperties.AutomationId="HostQuitButton" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

    <Grid x:Name="ClientModeContent" Margin="20" Visibility="Collapsed" Background="#FF24272D">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionStateLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel><TextBlock Text="Remote Desktop" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Open desktops and app windows from your paired computers" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,14" CornerRadius="9" Background="#FF333C49">
            <StackPanel><TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding NoticeDetail}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="ClientSidebar" Padding="16" CornerRadius="12" Background="{StaticResource PanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshHostsCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                            <TextBlock Text="NEARBY COMPUTERS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                        <ListBox ItemsSource="{Binding DiscoveredHosts}" SelectedItem="{Binding SelectedDiscoveredHost}" MinHeight="68" MaxHeight="150" Margin="0,10,0,0" AutomationProperties.AutomationId="NearbyClientHosts">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding EndpointLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No nearby computers. Keep Peel Pro open on the other computer." FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasNoDiscoveredHosts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="PAIRED COMPUTERS" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                        <ListBox ItemsSource="{Binding SavedHosts}" SelectedItem="{Binding SelectedSavedHost}" MinHeight="52" MaxHeight="130" AutomationProperties.AutomationId="SavedClientHosts">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EndpointLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" ToolTip="Open a secure connection to the selected paired computer." AutomationProperties.AutomationId="ClientConnect"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/></UniformGrid>
                        <Expander Header="Pair with a PIN" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0"><TextBlock Text="Select a nearby computer, then enter the six-digit PIN shown in its Peel Pro pairing screen." FontSize="11" TextWrapping="Wrap"/>
                                <PasswordBox x:Name="ClientPairingPin" MaxLength="6" Padding="8" Margin="0,8,0,8" AutomationProperties.Name="Six-digit pairing PIN"/>
                                <Button Content="Pair selected computer" Click="PairClientHost_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.AutomationId="ClientPair"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Private network / VPN address" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0"><TextBlock Text="Pair nearby first. Use the paired computer's actual TLS address and port." FontSize="11" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding DirectAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,8,0,6" AutomationProperties.Name="Private hostname or IP address"/>
                                <TextBox Text="{Binding DirectPort, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Computer TLS port"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Save" Command="{Binding SaveAddressCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveAddressCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/></UniformGrid>
                            </StackPanel>
                        </Expander>
                        <Button Content="Forget selected pairing" Click="ForgetClientHost_Click" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" AutomationProperties.AutomationId="ClientForget"/>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshWindowsCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                            <TextBlock Text="DESKTOPS &amp; APPS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                        <TextBox Text="{Binding WindowSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,8,0,8" AutomationProperties.Name="Search desktops and apps"/>
                        <ListBox ItemsSource="{Binding RemoteWindows}" SelectedItem="{Binding SelectedWindow}" MouseDoubleClick="RemoteWindowCatalog_MouseDoubleClick" MinHeight="80" MaxHeight="240" AutomationProperties.AutomationId="RemoteWindowCatalog">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding OwnerName}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Open" Click="OpenDetachedViewer_Click" IsEnabled="{Binding CanOpenSelectedWindow}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" ToolTip="Open the selected desktop or app window in its own window. This list stays open. Control starts off." AutomationProperties.AutomationId="OpenDetachedViewer"/>
                        <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Show here" Command="{Binding StartStreamCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" ToolTip="Stream the selected desktop or app window in the viewer beside this list." AutomationProperties.AutomationId="OpenSelectedHere"/>
                            <Button Content="Stop" Command="{Binding StopStreamCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" ToolTip="Stop the stream shown beside this list."/></UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="ClientViewerPanel" Grid.Column="2" Padding="16" CornerRadius="12" Background="#FF111318">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" Visibility="{Binding SourceControls.ShowMediaGroup, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Streamed computer media controls">
                                <Button Content="{Binding SourceControls.PreviousTrackGlyph}" Command="{Binding SourceControls.PreviousTrackCommand}" ToolTip="{Binding SourceControls.PreviousTrackToolTip}" Style="{StaticResource SourceIconButton}" AutomationProperties.Name="Previous track on the streamed computer" AutomationProperties.AutomationId="SourcePreviousTrack"/>
                                <Button Content="{Binding SourceControls.PlayPauseGlyph}" Command="{Binding SourceControls.PlayPauseCommand}" ToolTip="{Binding SourceControls.PlayPauseToolTip}" Style="{StaticResource SourceIconButton}" Margin="4,0" AutomationProperties.Name="Play or pause on the streamed computer" AutomationProperties.AutomationId="SourcePlayPause"/>
                                <Button Content="{Binding SourceControls.NextTrackGlyph}" Command="{Binding SourceControls.NextTrackCommand}" ToolTip="{Binding SourceControls.NextTrackToolTip}" Style="{StaticResource SourceIconButton}" AutomationProperties.Name="Next track on the streamed computer" AutomationProperties.AutomationId="SourceNextTrack"/>
                            </StackPanel>
                            <Grid Margin="0,0,8,0" Visibility="{Binding SourceControls.ShowVolumeGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button x:Name="SourceVolumeButton" Content="{Binding SourceControls.VolumeGlyph}" Command="{Binding SourceControls.ToggleVolumeCommand}" IsHitTestVisible="{Binding SourceControls.IsVolumeClosed}" ToolTip="{Binding SourceControls.VolumeToolTip}" Style="{StaticResource SourceIconButton}" AutomationProperties.Name="Streamed computer volume" AutomationProperties.AutomationId="SourceVolume"/>
                                <Popup IsOpen="{Binding SourceControls.IsVolumeOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SourceVolumeButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Width="240" Margin="0,6,0,0">
                                        <StackPanel>
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SourceControls.VolumeLabel}" Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="Streamed computer volume" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/></DockPanel>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding SourceControls.VolumeSliderValue, Mode=TwoWay}" IsEnabled="{Binding SourceControls.CanSetVolume}" Margin="0,10,0,8" AutomationProperties.Name="Streamed computer volume level"/>
                                            <Button Content="{Binding SourceControls.MuteButtonLabel}" Command="{Binding SourceControls.ToggleMuteCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Left" AutomationProperties.AutomationId="SourceMute"/>
                                            <TextBlock Text="{Binding SourceControls.VolumeHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Content="{Binding ControlButtonLabel}" Command="{Binding ToggleControlCommand}" Click="EnableClientControl_Click" Style="{StaticResource SecondaryButton}" ToolTip="Start or stop sending your mouse and keyboard to the remote computer. That computer must also allow control." AutomationProperties.AutomationId="ClientControl"/>
                            <Button Content="Expand viewer" Click="ClientFullScreen_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="Show or hide the computer list. Control is released when you switch."/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding SurfaceTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StreamStateLabel}" Foreground="#FFB3B8C4" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#FF08090C" Margin="0,14" BorderBrush="#FF353944" BorderThickness="1" CornerRadius="8">
                        <Grid x:Name="ClientVideoSurface" Focusable="True" Background="Transparent"
                            MouseMove="ClientSurface_MouseMove" MouseDown="ClientSurface_MouseDown" MouseUp="ClientSurface_MouseUp" MouseWheel="ClientSurface_MouseWheel"
                            PreviewKeyDown="ClientSurface_KeyDown" PreviewKeyUp="ClientSurface_KeyUp" LostKeyboardFocus="ClientSurface_LostKeyboardFocus"
                            LostMouseCapture="ClientSurface_LostMouseCapture"
                            AutomationProperties.Name="Remote video and control surface">
                            <TextBlock Text="{Binding SurfaceMessage}" Foreground="#FFB3B8C4" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Image Source="{Binding PeeledFrameSource}" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="LowQuality" IsHitTestVisible="False" AutomationProperties.AutomationId="PeeledFrameSurface"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2"><TextBlock Text="{Binding FrameStatistics}" Foreground="#FFB3B8C4" FontSize="12"/>
                        <TextBlock Text="{Binding ControlStatus}" Foreground="#FFB3B8C4" TextWrapping="Wrap" FontSize="12"/>
