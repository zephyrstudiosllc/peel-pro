<Window x:Class="Peel.Windows.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:utilities="clr-namespace:Peel.Windows.Client.Utilities"
        Title="Peel Pro"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF25292C"
        BorderBrush="#FF34393C"
        BorderThickness="1"
        Icon="/Peel.Windows;component/Assets/PeelHostMenuBarIcon_256x256.png"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="24"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Utilities/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="InkBrush" Color="#FFEDF0F4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA4ADB9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF292D35" />
        <SolidColorBrush x:Key="LineBrush" Color="#FF414650" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF3B404A" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="SourceIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ChromeCircleButton" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Circle"
                                     Width="14"
                                     Height="14"
                                     Fill="#FF666B6E"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8A8F92" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeIconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeIconBackground" Property="Background" Value="#FF303538" />
                                <Setter Property="Foreground" Value="#FFD5D8DA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                Padding="11,9"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#FF353C47" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#FF354F6C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary></Window.Resources>

    <Grid x:Name="WindowRoot" Background="#FF25292C">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="WindowChromeBar"
                Grid.Row="0"
                Background="#FF25292C"
                BorderBrush="#FF2F3437"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="18,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Button Click="CloseHostWindow_Click"
                            Style="{StaticResource ChromeCircleButton}"
                            AutomationProperties.AutomationId="MacCloseButton"
                            AutomationProperties.Name="Close" />
                    <Button Click="MinimizeWindow_Click"
                            Style="{StaticResource ChromeCircleButton}"
                            Margin="7,0,0,0"
                            AutomationProperties.AutomationId="MacMinimizeButton"
                            AutomationProperties.Name="Minimize" />
                    <Button x:Name="ZoomWindowButton"
                            Click="ZoomWindow_Click"
                            Style="{StaticResource ChromeCircleButton}"
                            Margin="7,0,0,0"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="MacZoomButton"
                            AutomationProperties.Name="Zoom" />
                    <TextBlock x:Name="WindowCaptionText"
                               Text="Peel Pro"
                               Margin="28,0,0,1"
                               Foreground="#FF8A8F92"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="RemoteDesktopModeButton"
                            Click="RemoteDesktopMode_Click"
                            Style="{StaticResource ChromeIconButton}"
                            Width="Auto"
                            Margin="0,0,6,0"
                            ToolTip="Remote Desktop: connect to a paired computer, or share this PC with your paired devices."
                            AutomationProperties.AutomationId="RemoteDesktopModeButton"
                            AutomationProperties.Name="Remote Desktop: Share This PC">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect to a computer"
                                          IsCheckable="True"
                                          Click="ShowClientMode_Click"
                                          ToolTip="Open desktops and app windows from your paired computers."
                                          AutomationProperties.AutomationId="RemoteDesktopConnectMenuItem" />
                                <MenuItem Header="Share This PC"
                                          IsCheckable="True"
                                          IsChecked="True"
                                          Click="ShowHostMode_Click"
                                          ToolTip="Let your paired devices view and, with your permission, control this PC."
                                          AutomationProperties.AutomationId="RemoteDesktopShareMenuItem" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" Margin="14,0,12,0">
                            <TextBlock Text="Remote Desktop ·" Foreground="#FF8A8F92" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="RemoteDesktopModeText" Text="Share This PC" Foreground="#FFE4E7E9" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFB3B8C4" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HostSettingsButton"
                            Click="HostSettings_Click"
                            Style="{StaticResource ChromeIconButton}"
                            AutomationProperties.AutomationId="HostSettingsButton"
                            AutomationProperties.Name="Settings">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Share This PC"
                                          IsCheckable="True"
                                          IsChecked="True"
                                          Click="ShowHostMode_Click"
                                          ToolTip="Let your paired devices view and, with your permission, control this PC."
                                          AutomationProperties.AutomationId="HostModeMenuItem" />
                                <MenuItem Header="Remote Desktop"
                                          IsCheckable="True"
                                          Click="ShowClientMode_Click"
                                          ToolTip="Connect to another paired computer's desktops and app windows."
                                          AutomationProperties.AutomationId="ClientModeMenuItem" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Foreground="White" />
                    </Button>
                    <Button Click="AboutPeel_Click"
                            Style="{StaticResource ChromeIconButton}"
                            AutomationProperties.AutomationId="HostAboutButton"
                            AutomationProperties.Name="About Peel Pro">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Background="#292B31" BorderBrush="#41434A" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel Margin="12,14">
            <ListBox x:Name="StudioNavigation" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource StudioSelection}" SelectionChanged="StudioNavigation_SelectionChanged" AutomationProperties.Name="Peel sidebar">
             <ListBoxItem IsEnabled="False" Padding="8,4"><TextBlock Text="Peel Pro" Style="{StaticResource StudioCaption}" Margin="0"/></ListBoxItem>
             <ListBoxItem Tag="host" AutomationProperties.AutomationId="HostNavigation" AutomationProperties.Name="Share This PC" ToolTip="Pair devices and choose whether they may control this PC."><TextBlock Text="▣   Share This PC"/></ListBoxItem>
             <ListBoxItem Tag="remote" AutomationProperties.AutomationId="RemoteNavigation" AutomationProperties.Name="Remote Desktop" ToolTip="Connect to a paired computer and open its desktops or app windows."><TextBlock Text="▱   Remote Desktop"/></ListBoxItem>
             <ListBoxItem Tag="4"><TextBlock Text="⚙   Settings"/></ListBoxItem>
             <ListBoxItem IsEnabled="False" Padding="8,18,8,4"><TextBlock Text="Notch Pulse" Style="{StaticResource StudioCaption}" Margin="0"/></ListBoxItem>
             <ListBoxItem Tag="7"><TextBlock Text="◉   Overview"/></ListBoxItem>
             <ListBoxItem Tag="15" AutomationProperties.AutomationId="LightingNavigation"><TextBlock Text="✦   Lighting"/></ListBoxItem>
             <ListBoxItem Tag="2"><TextBlock Text="◈   Agents"/></ListBoxItem>
             <ListBoxItem Tag="10"><TextBlock Text="▥   Hardware"/></ListBoxItem>
             <ListBoxItem Tag="11"><TextBlock Text="⚙   Settings"/></ListBoxItem>
             <ListBoxItem IsEnabled="False" Padding="8,18,8,4"><TextBlock Text="Usage Limits" Style="{StaticResource StudioCaption}" Margin="0"/></ListBoxItem>
             <ListBoxItem Tag="1" AutomationProperties.AutomationId="UsageNavigation"><TextBlock Text="◷   All allowances"/></ListBoxItem>
             <ListBoxItem IsEnabled="False" Padding="8,18,8,4"><TextBlock Text="App Mechanic" Style="{StaticResource StudioCaption}" Margin="0"/></ListBoxItem>
             <ListBoxItem Tag="0" AutomationProperties.AutomationId="MechanicNavigation"><TextBlock Text="◴   Overview"/></ListBoxItem>
             <ListBoxItem Tag="3"><TextBlock Text="♧   Alerts"/></ListBoxItem>
             <ListBoxItem Tag="8"><TextBlock Text="⌁   History"/></ListBoxItem>
             <ListBoxItem Tag="9"><TextBlock Text="⚙   Settings"/></ListBoxItem>
            </ListBox>
            <TextBlock Text="PEEL PRO · WINDOWS" FontSize="10" Foreground="#818B98" Margin="12,28,0,10"/>
           </StackPanel>
          </ScrollViewer>
         </Border>
        <Grid x:Name="ModeSurface" Grid.Column="1" Background="{StaticResource StudioBackground}">
            <utilities:CommandCenterView x:Name="CommandCenter" Visibility="Collapsed"/>
            <Border x:Name="HostModeContent" Background="Transparent" MaxWidth="660" HorizontalAlignment="Stretch">
                <Border.Resources>
                    <SolidColorBrush x:Key="HostTextBrush" Color="#FFE4E7E9" />
                    <SolidColorBrush x:Key="HostMutedBrush" Color="#FF909598" />
                    <SolidColorBrush x:Key="HostCardBrush" Color="#FF292E32" />
                    <SolidColorBrush x:Key="HostButtonBrush" Color="#FF35393C" />
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource HostTextBrush}" />
                    </Style>
                    <Style x:Key="HostDisclosureButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource HostTextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="MinHeight" Value="60" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DisclosureBackground"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DisclosureBackground" Property="Background" Value="#FF303538" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="DisclosureBackground" Property="BorderBrush" Value="#FFF36B2B" />
                                            <Setter TargetName="DisclosureBackground" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="HostSmallButton" TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource HostButtonBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource HostTextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,7" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.88" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.42" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="HostSubDisclosureButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource HostTextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.80" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="HostSwitch" TargetType="CheckBox">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="SwitchTrack"
                                            Width="32"
                                            Height="20"
                                            CornerRadius="10"
                                            Background="#FF555A5D">
                                        <Ellipse x:Name="SwitchThumb"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="2"
                                                 Fill="#FFE7E9EA"
                                                 HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SwitchTrack" Property="Background" Value="#FF34C759" />
                                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="HostListBoxItem" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="HostSelectionBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HostSelectionBorder" Property="Background" Value="#FF303538" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="HostSelectionBorder" Property="Background" Value="#FF34393C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <Grid MaxWidth="660" HorizontalAlignment="Stretch" Background="#FF25292C">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="166" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="196" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Image Width="52"
                               Height="52"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Stretch="Uniform"
                               Source="/Peel.Windows;component/Assets/PeelHostMenuBarIcon_256x256.png"
                               AutomationProperties.Name="Peel Pro" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,75,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="HostRuntimeStatus">
                            <Ellipse x:Name="HostStatusDot"
                                     Width="10" Height="10"
                                     Fill="#FF8B8782"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="HostStatusText"
                                       Text="Starting…"
                                       FontSize="15"
                                       FontWeight="Medium" />
                        </StackPanel>
                        <TextBlock x:Name="HostRemoteConnectionStatusText"
                                   Text="Opening secure hosting…"
                                   Margin="0,115,0,0"
                                   Width="380"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource HostMutedBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="HostRemoteConnectionStatus" />
                    </Grid>

                    <Border Grid.Row="1" Margin="56,0" Background="#FF373B3E" />

                    <ScrollViewer x:Name="HostSectionsScrollViewer"
                                  Grid.Row="2"
                                  Margin="48,32,48,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="HostNoticeBorder"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,14"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#FF402E26"
                                    BorderBrush="#FF7A4A35"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="HostNoticeTitleText"
                                               Text="Secure hosting needs attention"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="HostNoticeDetailText"
                                               Margin="0,4,0,0"
                                               Foreground="#FFD0B1A4"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="RetryHostRuntimeButton"
                                            Content="Retry secure hosting"
                                            Click="RetryHostRuntime_Click"
                                            Style="{StaticResource HostSmallButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Visibility="Collapsed"
                                            AutomationProperties.AutomationId="RetrySecureHostButton"
                                            AutomationProperties.Name="Retry secure hosting" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource HostCardBrush}" CornerRadius="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Button Click="HostSetupDisclosure_Click"
                                            Style="{StaticResource HostDisclosureButton}"
                                            AutomationProperties.AutomationId="HostSetupDisclosure"
                                            AutomationProperties.Name="Setup">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Setup" FontSize="14" FontWeight="SemiBold" />
                                                <Border Margin="8,0,0,0"
                                                        Background="#FF3A3F42"
                                                        CornerRadius="10"
                                                        Padding="7,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="HostSetupSummaryText"
                                                               Text="—"
                                                               Foreground="{StaticResource HostMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Peel Pro needs these permissions to function."
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource HostMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="HostSetupContent" Visibility="Collapsed" Margin="12,0,12,12">
                                        <TextBlock Text="Peel Pro needs these permissions in order to function:"
                                                   Margin="0,0,0,10"
                                                   Foreground="{StaticResource HostMutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Ellipse Width="10" Height="10" Fill="#FF34C759" Margin="0,3,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Local Network" FontWeight="SemiBold" />
                                                    <TextBlock Text="Listening" Margin="8,1,0,0" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock x:Name="HostDiscoveryStatusText"
                                                           Text="This PC is available to paired Peel Pro devices."
                                                           Margin="0,3,0,0"
                                                           Foreground="{StaticResource HostMutedBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Ellipse Width="10" Height="10" Fill="#FF34C759" Margin="0,3,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Screen Capture" FontWeight="SemiBold" />
                                                    <TextBlock Text="Ready" Margin="8,1,0,0" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="Needed so Peel Pro can stream Windows app windows and whole displays."
                                                           Margin="0,3,0,0"
                                                           Foreground="{StaticResource HostMutedBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="HostRemoteInputStatusDot"
                                                     Width="10" Height="10"
                                                     Fill="#FF8B8782"
                                                     Margin="0,3,10,0"
                                                     VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Remote Input" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="HostRemoteInputStatusText"
                                                               Text="Off"
                                                               Margin="8,1,0,0"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource HostMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="Allows a paired device to control this PC. Off by default."
                                                           Margin="0,3,10,0"
                                                           Foreground="{StaticResource HostMutedBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox x:Name="HostRemoteInputCheckBox"
